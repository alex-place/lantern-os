#!/bin/sh
# Per-agent workstream gate + master protection + change-record gate (pre-push)
#
# Master merge override:     OVERRIDE_MERGE=1 git push origin master
# Workstream bypass:         SKIP_MONOWORKSTREAM=1 git push ...
# Change-record/bump bypass: SKIP_VERSION_CHECK=1 git push ...

# ── 1. Master protection ─────────────────────────────────────────────────────
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/master" ]; then
    if [ "$OVERRIDE_MERGE" = "1" ]; then
      echo "[merge] OVERRIDE_MERGE=1 — allowing direct push to master."
    else
      echo ""
      echo "MASTER PROTECTION: direct push to master is blocked."
      echo "Open a pull request, or set OVERRIDE_MERGE=1 to force."
      echo ""
      exit 1
    fi
  fi
done

# ── 2. Change-record + version-bump gate ─────────────────────────────────────
# A code-bearing branch must bump package.json to a new X.X.X version AND carry a
# matching CHANGELOG.MD entry, relative to origin/master. Runs BEFORE the gh /
# workstream checks below so it is enforced even without gh and even on branches
# that already have an open PR.
# Bypass: SKIP_VERSION_CHECK=1 (or SKIP_MONOWORKSTREAM=1) git push ...
if [ "$SKIP_MONOWORKSTREAM" != "1" ] && [ "$SKIP_VERSION_CHECK" != "1" ]; then
  _root=$(git rev-parse --show-toplevel 2>/dev/null)
  _validator="$_root/scripts/validate-prepush-version-changelog.py"
  if [ -f "$_validator" ]; then
    _py=$(command -v python3 2>/dev/null || command -v python 2>/dev/null)
    if [ -n "$_py" ]; then
      if ! "$_py" "$_validator"; then
        exit 1
      fi
    else
      echo "[prepush] python not found on PATH — skipping change-record gate."
    fi
  fi
fi

# ── 2b. Stale-clobber gate ───────────────────────────────────────────────────
# Blocks pushes whose file contents are byte-identical to OLDER master versions
# (a stale worktree "sync" silently reverting merged work — the 2fd3598c bug).
# Deliberately NOT bypassed by SKIP_MONOWORKSTREAM (automation caused the bug).
# Bypass: SKIP_CLOBBER_CHECK=1 git push ...
if [ "$SKIP_CLOBBER_CHECK" != "1" ]; then
  _root=$(git rev-parse --show-toplevel 2>/dev/null)
  _clobber="$_root/scripts/validate-prepush-stale-clobber.py"
  if [ -f "$_clobber" ]; then
    _py=$(command -v python3 2>/dev/null || command -v python 2>/dev/null)
    if [ -n "$_py" ]; then
      if ! "$_py" "$_clobber"; then
        exit 1
      fi
    fi
  fi
fi

# ── 2c. Sprawl tripwire: new public surfaces must declare a loop stage ───────
# Every NEW apps/lantern-garage/public/*.html must carry a loop-stage justification
# (a <meta name="loop-stage"> or <!-- loop-stage: --> comment) so scope can't
# silently regrow (#1561). This is the SAME check CI runs; enforcing it at push
# time catches an unjustified surface locally instead of in PR review — the exact
# gap that let #1975's kalshi-screener.html / reset-password.html reach CI.
# Bypass: SKIP_SPRAWL_CHECK=1 (or SKIP_MONOWORKSTREAM=1) git push ...
if [ "$SKIP_MONOWORKSTREAM" != "1" ] && [ "$SKIP_SPRAWL_CHECK" != "1" ]; then
  _root=$(git rev-parse --show-toplevel 2>/dev/null)
  _tripwire="$_root/scripts/sprawl-tripwire.mjs"
  if [ -f "$_tripwire" ]; then
    _node=$(command -v node 2>/dev/null)
    if [ -n "$_node" ]; then
      if ! "$_node" "$_tripwire" --base origin/master; then
        echo ""
        echo "Bypass: SKIP_SPRAWL_CHECK=1 (or SKIP_MONOWORKSTREAM=1) git push ..."
        echo ""
        exit 1
      fi
    else
      echo "[prepush] node not found on PATH — skipping sprawl tripwire."
    fi
  fi
fi

# ── 2d. No deterministic keyword intent-routing in the chat surface ──────────
# The chat routes capabilities through the model's native tool calls, not pre-LLM
# keyword/regex intercepts (which once turned "world news" into "Now playing — Super
# Mario World"). This SAME check runs in CI; enforcing it at push time catches a
# reintroduced keyword classifier / intercept locally instead of in PR review.
# Bypass: SKIP_INTENT_ROUTING_CHECK=1 (or SKIP_MONOWORKSTREAM=1) git push ...
if [ "$SKIP_MONOWORKSTREAM" != "1" ] && [ "$SKIP_INTENT_ROUTING_CHECK" != "1" ]; then
  _root=$(git rev-parse --show-toplevel 2>/dev/null)
  _guard="$_root/scripts/no-keyword-intent-routing.mjs"
  if [ -f "$_guard" ]; then
    _node=$(command -v node 2>/dev/null)
    if [ -n "$_node" ]; then
      if ! "$_node" "$_guard" --base origin/master; then
        echo ""
        echo "Bypass: SKIP_INTENT_ROUTING_CHECK=1 (or SKIP_MONOWORKSTREAM=1) git push ..."
        echo ""
        exit 1
      fi
    else
      echo "[prepush] node not found on PATH — skipping keyword-intent-routing guard."
    fi
  fi
fi

# ── 3. Per-agent workstream / per-lane PR cap: REMOVED ───────────────────────
# The concurrent open-PR cap per lane was removed intentionally — a lane may keep
# any number of open PRs at once. Merge-time serialisation is handled by the single
# in-process merger (apps/lantern-garage/lib/pr-watcher.js), which lands one
# green + reviewed PR per tick. The slop / secret / change-record gates above still
# apply; SKIP_MONOWORKSTREAM=1 still bypasses those.

# ── 4. Staleness guard: block pushes on branches far behind master ────────────
_branch=$(git symbolic-ref --short HEAD 2>/dev/null)
case "$_branch" in gh-pages|master|dev|"") ;;
*)
  _behind=$(git rev-list --count HEAD..origin/master 2>/dev/null || echo 0)
  if [ "$_behind" -gt 50 ]; then
    echo ""
    echo "STALENESS BLOCK: '$_branch' is $_behind commits behind origin/master."
    echo "Pushing now risks large merge conflicts and dropped work."
    echo ""
    echo "Sync first:"
    echo "  git fetch origin"
    echo "  git rebase origin/master   # or: git merge origin/master"
    echo ""
    echo "Bypass: SKIP_MONOWORKSTREAM=1 git push ..."
    echo ""
    exit 1
  elif [ "$_behind" -gt 10 ]; then
    echo ""
    echo "WARNING: '$_branch' is $_behind commits behind origin/master."
    echo "Consider syncing: git fetch origin && git rebase origin/master"
    echo ""
  fi
  ;;
esac

# ── 5. Git LFS ───────────────────────────────────────────────────────────────
command -v git-lfs >/dev/null 2>&1 || {
  echo "Warning: git-lfs not found on PATH. LFS pre-push hook skipped."
  exit 0
}
git lfs pre-push "$@"
