+// STEP FLOOR BY SYMBOL (2026-09-28 lab, ledger row floor-by-volatility-class). One step size for
+// every name treats a 1% move as the same event in TLT (a full day's range) and in SOXL (a
+// twentieth of one). Split by the volatility class of the name, the gain of the wider 1.5% floor
+// over thirteen windows lived in the volatile names (1x commodity and semiconductor funds +5,061,
+// 2x/3x wrappers +3,866 on 100k) while the quiet index, bond and gold funds paid for it (-1,282);
+// 0.75% lost in every class.
+//   TRADER_STEP_FLOOR_BY_SYMBOL="SMH:1.5,GDX:1.5,..."   step size in PERCENT for the names listed;
+//                                                       every other name keeps TRADER_STEP_FLOOR
+// Unset = one floor for every name, exactly as before. It changes the step SIZE only: with
+// TRADER_STEP_FLOOR unset or 0 the stepped floor is off and this does nothing. Clamped to [0.25, 5].
+function _stepFloorFor(sym, base, spec = process.env.TRADER_STEP_FLOOR_BY_SYMBOL) {
+  if (!(base > 0) || !spec || !sym) return base;
+  const want = String(sym).toUpperCase();
+  for (const part of String(spec).split(',')) {
+    const [n, w] = part.split(':').map((x) => String(x || '').trim());
+    if (n.toUpperCase() === want) { const v = Number(w); return Number.isFinite(v) && v > 0 ? Math.min(5, Math.max(0.25, v)) : base; }
+  }
+  return base;
+}
