{
  "name": "lantern-garage-app",
  "version": "1.11.0",
  "private": true,
  "description": "Local-first Lantern OS garage full-stack app.",
  "scripts": {
    "setup": "node ../../scripts/ensure-rust.js || true",
    "prepare": "node ../../scripts/setup-hooks.mjs",
    "prestart": "npm run setup",
    "start": "node server.js",
    "start:dev": "node server-dev.js",
    "start:local": "node server.js",
    "start:sd": "python ../../src/sd_image_server.py",
    "check": "node --check server.js",
    "lint:pages": "node ../../scripts/lint-throwaway-pages.mjs",
    "audit:orphans": "node ../../scripts/find-orphan-pages.mjs",
    "validate": "node validate.js",
    "test": "node ../../tests/run-dream-journal-tests.js api chat multiturn keystone cache",
    "test:api": "node ../../tests/test_dream_journal_api.js",
    "test:chat": "node ../../tests/test_dream_journal_chat.js",
    "test:multiturn": "node ../../tests/test_dream_chat_multiturns.js",
    "test:keystone": "node ../../tests/test_dream_journal_keystone.js",
    "test:cache": "node ../../tests/test_provider_cache.js",
    "test:ui": "npx playwright test ../../tests/test_dream_journal_ui.spec.js",
    "test:ui:headed": "npx playwright test ../../tests/test_dream_journal_ui.spec.js --headed",
    "test:dream-chat-ui": "npx playwright test ../../tests/test_dream_chat_ux.spec.js",
    "test:auth": "npm --prefix ../.. run test:auth",
    "test:three-doors": "node ../../tests/test_three_doors_integration.spec.js",
    "test:showcase": "node test/static-mime.test.js && node test/showcase-manifest.test.js && node test/showcase-gallery-ui.test.js",
    "test:boundary": "node test/surface-boundary.test.js",
    "test:brand": "node test/brand-unisona.test.js",
    "test:coding-backend": "node test/coding-backend.test.js",
    "test:local-engine": "node test/local-engine-qwen.test.js",
    "test:coding-router": "node test/coding-router.test.js",
    "test:coding-verifier": "node test/coding-verifier.test.js",
    "test:coding-tool": "node test/coding-tool.test.js",
    "test:tenant": "node test/tenant.test.js",
    "test:byok": "node test/user-provider-keys.test.js",
    "test:profile": "node test/deployment-profile.test.js",
    "test:desktop": "node test/desktop-phase0.test.js",
    "test:appdata": "node test/appdata-migration.test.js",
    "test:desktop-token": "node test/desktop-loopback-token.test.js && node test/desktop-loopback-token-http.test.js",
    "test:mcp-msg": "node test/chat-mcp-message.test.js",
    "test:finnhub-gate": "node test/finnhub-legal-gate.test.js",
    "test:trade-gate": "node test/kalshi-fees-ev.test.js",
    "test:portfolio": "node test/portfolio-analytics.test.js",
    "test:tool-identity": "node test/chat-tool-user-identity.test.js",
    "test:grounded": "node test/kalshi-grounded.test.js",
    "test:verify-llm": "node test/verify-llm.test.js",
    "test:hooks": "node test/git-hooks-repo-managed.test.js",
    "test:convergence-tool": "node test/convergence-inspect-tool.test.js",
    "test:sigma0": "node test/surface-boundary.test.js && node test/no-keyword-routing.test.js && node test/kalshi-fees-ev.test.js && node test/kalshi-grounded.test.js && node test/tenant.test.js && node test/deployment-profile.test.js && node test/desktop-phase0.test.js && node test/appdata-migration.test.js && node test/desktop-loopback-token.test.js && node test/desktop-loopback-token-http.test.js && node test/verify-llm.test.js && node test/git-hooks-repo-managed.test.js && node test/convergence-inspect-tool.test.js",
    "test:sprint16": "node ../../tests/test_sprint16_dashboards.js",
    "test:all": "node ../../tests/run-dream-journal-tests.js api chat multiturn keystone cache ui dream-chat-ui && npm run test:three-doors",
    "dev": "node --watch server.js",
    "desktop": "node desktop/launcher.js",
    "screenshot": "node scripts/screenshot.js",
    "shot:dev": "node scripts/screenshot.js http://127.0.0.1:4178/dream-chat.html ../../keystone-dreamchat-4178.png",
    "start:master": "git -C ../.. pull origin master && node --watch server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "exif-parser": "^0.1.12",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.9.0",
    "lantern-os": "file:../..",
    "mammoth": "^1.12.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "playwright": "^1.61.0"
  },
  "optionalDependencies": {
    "win-ca": "^3.5.1",
    "stripe": "^18.0.0"
  }
}
