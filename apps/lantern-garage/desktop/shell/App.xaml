<Application x:Class="Unisona.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Palette mirrors the web app's dark ground / comet-cyan accent. -->
    <Color x:Key="GroundColor">#FF0A0E14</Color>
    <Color x:Key="PanelColor">#FF111823</Color>
    <Color x:Key="InkColor">#FFE6EDF6</Color>
    <Color x:Key="InkSoftColor">#FF93A3B8</Color>
    <Color x:Key="AccentColor">#FF38C7D4</Color>
    <SolidColorBrush x:Key="Ground" Color="{StaticResource GroundColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkSoft" Color="{StaticResource InkSoftColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
  </Application.Resources>
</Application>
