# ============================================================================
# AGENTIC TOOLS / CHAT HARNESS (per-setup overrides — all optional)
# ============================================================================
# GitHub repo the chat's GitHub tools (github_issue, list_pull_requests, …) target.
# Leave unset to auto-detect owner/repo from `git remote get-url origin`, so a fork
# points at its own repo instead of the upstream default. (#2759)
# GH_REPO=owner/repo
#
# MCP sidecar the chat reaches for MCP-backed tools (default 127.0.0.1:8771). (#2759)
# MCP_HOST=127.0.0.1
# MCP_PORT=8771
#
# Max agentic tool-call iterations per chat turn (default 12 cloud / 10 local). (#2755)
# CHAT_MAX_TOOL_ITERS=12
#
# Per-provider reply-length cap (output tokens). Unset = historical defaults
# (anthropic 512 · gemini 4096 · xai 512). CHAT_MAX_TOKENS sets a fallback for any
# provider without its own var; a per-provider var wins over it. (#2759)
# CHAT_MAX_TOKENS=
# CHAT_MAX_TOKENS_ANTHROPIC=512
# CHAT_MAX_TOKENS_GEMINI=4096
# CHAT_MAX_TOKENS_XAI=512
#
# Per-faculty tool gating for capability evals (#2777): comma/space-separated tool
# names to DENY for a run, so a memory eval can't substitute web_search for recall
# (Burnell et al. §4.3). runTool returns reason_code "tool_gated" + logs it. Unset =
# no gating. See docs/CHAT-EVAL-RECIPE.md. e.g.:
# CHAT_EVAL_GATED_TOOLS=web_search,web_fetch

# ============================================================================
# NOTES
# ============================================================================
#
# 1. MINIMUM for Dream Chat: Set at least ONE AI provider
#    (ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, or Ollama)
#
# 2. Provider Failover (automatic):
#    Ollama → Anthropic → Gemini → OpenAI → Offline fallback
#
# 3. Start: npm start
#    Access: http://127.0.0.1:4177/dream-chat.html
#
# 4. Never commit .env with real API keys!

# ============================================================================
# BRAND LOGOS (optional — stock-trader watchlist/search badges)
# ============================================================================
# logo.dev gives crisp, icon-style, high-res brand logos (better than the FMP
# fallback). Get a free publishable token at https://logo.dev (looks like pk_...).
# Without this the trader falls back to FMP logos automatically.
# LOCAL:  add the line below to .env.local (gitignored — never commit the token).
# CLOUD (Railway): do NOT put it in the repo. Set LOGODEV_TOKEN in the Railway
#   service's Variables tab so the deployed site reads it from the environment.
# LOGODEV_TOKEN=pk_xxxxxxxxxxxxxxxxxxxx

# ============================================================================
# TRADER — API-spend controls (Σ₀ scan cache + adaptive cadence)
# ============================================================================
# Σ₀ scan cache: reuse a ticker's LLM read when its price is essentially
# unchanged since the last scan, so the model is only paid for when price moves.
# Grounding signals are still recomputed fresh, so it can't miss a setup.
# SIGMA0_SCAN_CACHE=1            # 0 to disable
# SIGMA0_SCAN_CACHE_BAND=0.0015  # price move (0.15%) that counts as "changed"
# SIGMA0_SCAN_CACHE_TTL=600      # re-read at least every N seconds
# Adaptive cadence: scan slower when the US market is closed (crypto-only, slow).
# TRADER_AUTOSCAN_MS=60000          # market-hours cadence
# TRADER_AUTOSCAN_CLOSED_MS=300000  # off-hours cadence (set =60000 to disable)
# Σ₀ grounding pre-gate: only spend the model on tickers that could actually ENTER
# (near a zone, or a real trend/news lean). Flat/featureless tickers would SKIP
# regardless, so they're dropped pre-LLM. Conservative + fail-open; held positions
# always pass. Provably can't drop a setup the full flow would take.
# SIGMA0_PREGATE=1               # 0 to disable
# SIGMA0_PREGATE_ZONE_PROX=3.5   # % distance to a zone that still counts as a candidate

# Upload cap for journal/video uploads (routes/dreamer.js); MB, default 5120 (5 GB)
# LANTERN_MAX_UPLOAD_MB=5120

# Human Flourishing Frameworks API (src/hff-api/app.py; proxied at /flourishing,
# dashboard on port 5100, auto-spawned by routes/flourishing.js on first request)
# HFF_ENABLED=0
# HFF_DATA_DIR=data/hff

# ── Worldwide-patent corpus (prior-art / IP grounding) ────────────────────────
# A local BM25 corpus of patents, harvested offline from EPO Open Patent Services
# (OPS) — the only free API with genuinely worldwide coverage. Folds into the research
# loop and backs the `patent_search` chat tool. Fail-safe: if the corpus is absent,
# retrieval returns nothing and chat is never blocked. See docs/PATENT-CORPUS.md.
#
# Free onboarding (once): register a free OPS account + app at https://developers.epo.org/
# (no credit card) to get a Consumer Key + Secret, then set both here (in .env.local
# locally — NEVER commit real keys). Then run:
#   python scripts/patent_harvest.py --dry-run                                    # validate the key
#   python scripts/patent_harvest.py --keywords "solid state battery" --from 2018 --max 200
#   python scripts/patent_build_index.py                                          # build the BM25 index
# EPO_OPS_KEY=
# EPO_OPS_SECRET=
# PATENT_CORPUS_DIR=F:\patent-corpus   # where raw/ + index/ live (default F:\patent-corpus)
# WIDE_SEARCH_PATENTS=1                 # 0 to drop patents from research rounds (default on)
# WIDE_SEARCH_PATENTS_K=4               # how many patents to fold into each research round
