# Lantern OS Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real secrets to version control

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Main server port (default: 4177)
LANTERN_GARAGE_PORT=4177

# Server bind address (127.0.0.1 for local only, 0.0.0.0 for all interfaces)
LANTERN_GARAGE_HOST=127.0.0.1

# ============================================================================
# AI PROVIDER CREDENTIALS (at least 1 required for Dream Chat)
# ============================================================================

# Anthropic Claude API
# Get key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-v0-...
# ANTHROPIC_MODEL=claude-opus-4-8|claude-sonnet-4-6|claude-haiku-4-5-20251001 (default: haiku)

# OpenAI ChatGPT API
# Get key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Google Gemini API
# Get key from: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSy...
# GEMINI_GROUNDING=true

# ============================================================================
# LOCAL AI (Ollama) - Optional
# Install from: https://ollama.ai
# ============================================================================

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=lantern-csf-dream
OLLAMA_TIMEOUT_MS=120000

# ============================================================================
# MCP SERVER (for context://personas resource)
# ============================================================================

MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8771
MCP_CLIENT_TIMEOUT=5000

# Shared Dream Chat/MCP tool execution is off unless explicitly enabled.
# Read tools remain repo-sandboxed; shell/write/edit still require operator mode.
# CHAT_TOOL_EXEC=1
# MCP_SHARED_TOOL_OPERATOR=1

# MCP public access (set MCP_PUBLIC=1 to bind 0.0.0.0 when running behind Cloudflare tunnel)
# MCP_PUBLIC=1

# Static API key for Grok / Claude Desktop Bearer auth (leave blank = open/no auth)
# MCP_API_KEY=your-secret-key-here

# OAuth base URL for ChatGPT connector (must match the public hostname)
MCP_BASE_URL=https://mcp.lantern-os.net

# OAuth client ID advertised to ChatGPT (must match what you enter in ChatGPT connector UI)
MCP_OAUTH_CLIENT_ID=chatgpt

# ============================================================================
# IMAGE GENERATION (Optional)
# ============================================================================

SD_HOST=127.0.0.1
SD_PORT=7860

# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=Rachel

# ============================================================================
# PATREON OAUTH (Optional — enables Patreon login + role-gating)
# ============================================================================

# Register the OAuth app on the SAME Patreon account that owns your campaign
# (patreon.com/cw/UnisonaAI): https://www.patreon.com/settings/developers
# A different campaign under a different account = register a NEW app here.
# PATREON_CLIENT_ID=...
# PATREON_CLIENT_SECRET=... (NEVER commit this!)
# PATREON_CAMPAIGN_ID=...  ⚠ REQUIRED. The identity.memberships scope returns a user's
#   memberships to EVERY creator they back, so gating filters to THIS campaign's
#   membership by id. Get it from GET https://www.patreon.com/api/oauth2/v2/campaigns
#   (logged in as the owner). If unset, a member who also backs another creator is
#   treated as having no membership here (fail-closed → guest / possible lockout).
#
# PATREON_REDIRECT_URI must EXACTLY match the redirect URI registered in your
# Patreon OAuth app (scheme, host, port, and path all matter):
#   Local dev:   http://127.0.0.1:4177/api/auth/patreon/callback
#   Production:  https://your-domain.com/api/auth/patreon/callback
# PATREON_REDIRECT_URI=http://127.0.0.1:4177/api/auth/patreon/callback
#
# Tier → role is gated by PLEDGE AMOUNT (cents), not campaign-specific tier ids, so a
# campaign move never breaks gating. Defaults: $5 → supporter, $20 → deep_dreamer (Pro:
# trading + all Pro features), $200 → pilot (adds the autonomous AI trader). A PURCHASABLE
# tier can NEVER grant the operator `admin` role — that would let anyone buy site takeover.
# Override the thresholds only if you re-price:
# PATREON_SUPPORTER_CENTS=500
# PATREON_DEEP_DREAMER_CENTS=2000
# PATREON_PILOT_CENTS=20000
#
# Owner/admin: set LANTERN_ADMIN_IDS to the campaign owner's Patreon USER id (the numeric
# id from https://www.patreon.com/api/oauth2/v2/identity while logged in as the owner) —
# this is the ONLY way to be admin (no tier grants it). Comma-separated; a bare id is read
# as patreon:<id>, qualify others as "google:<id>". ACCOUNT-bound, so it changes when you
# move to a new Patreon account. ⚠ If unset, NO ONE is admin (owner locked out).
# LANTERN_ADMIN_IDS=12345678
#
# SESSION_SECRET signs the login session cookie. If unset it falls back to an
# INSECURE shared dev value ("lantern-local-dev-secret-change-in-prod") — you
# MUST set a random value in any non-local deployment.
# SESSION_SECRET=

# ============================================================================
# STRIPE BILLING (Optional — native subscription checkout, a SECOND paid source
# alongside Patreon; #2568). When STRIPE_SECRET_KEY is UNSET the whole billing
# surface is inert: /api/billing/* answers 503 and the app boots without the SDK.
# ============================================================================
#
# Secret API key. sk_test_… for the test env, sk_live_… for production — the prefix
# also selects which webhook livemode the server accepts, so a test event can't mutate
# a live-keyed server (and vice-versa). NEVER commit the live key.
# STRIPE_SECRET_KEY=sk_test_...
#
# Webhook signing secret (Dashboard → Developers → Webhooks, or `stripe listen`). The
# webhook is the SOURCE OF TRUTH for entitlements; without this the webhook 503s.
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# One recurring Price id per tier (Product → Pricing in the Dashboard). These map a
# paid subscription to a role: supporter=$5 Member, deep_dreamer=$20 Pro (unlocks
# trading), pilot=$200 Pilot (unlocks the autonomous AI trader). Amounts must match the
# Patreon thresholds above. A purchase can NEVER grant admin.
# STRIPE_PRICE_SUPPORTER=price_...
# STRIPE_PRICE_DEEP_DREAMER=price_...
# STRIPE_PRICE_PILOT=price_...
#
# PUBLIC_BASE_URL — the canonical https origin of the deploy (e.g. https://unisona.ai).
# Stripe redirect targets (checkout success/cancel, portal return) are built from this.
# REQUIRED in production: without it the redirect falls back to request headers, and a
# forged X-Forwarded-Host could point the post-payment redirect off-domain. Local dev
# (127.0.0.1) works without it.
# PUBLIC_BASE_URL=https://unisona.ai

# ============================================================================
# GOOGLE OAUTH (Optional — enables "Continue with Google" sign-in)
# ============================================================================
# Full step-by-step setup: docs/GOOGLE-OAUTH.md
# Create credentials at https://console.cloud.google.com/apis/credentials
#   1. OAuth client ID → Application type "Web application"
#   2. Authorized redirect URIs must EXACTLY match this app's callback:
#        Local dev:   http://127.0.0.1:4177/api/auth/google/callback
#        Production:  https://your-domain.com/api/auth/google/callback
#   3. The Google button appears on the login page only when BOTH are present.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...   (NEVER commit this!)

# ============================================================================
# EMAIL / SMTP (enables real delivery of account confirmation + reset emails)
# ============================================================================
# Local email+password signups are HARD-GATED: the account is created but cannot
# sign in until the emailed confirmation link is clicked. Set these to send real
# mail via SMTP. If UNSET, the confirmation/reset link is instead written to the
# server log and data/mail-outbox.jsonl (dev/offline fallback) — so email signups
# will be effectively unusable in production until SMTP is configured.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587              # 465 for implicit TLS, 587 for STARTTLS
# SMTP_SECURE=0              # "1" for port 465 implicit TLS
# SMTP_USER=apikey-or-username
# SMTP_PASS=...              # (NEVER commit this!)
# MAIL_FROM=unisona.ai <no-reply@unisona.ai>   # defaults to SMTP_USER

# ============================================================================

# DISCORD_BOT_TOKEN=...
# LANTERN_DISCORD_GUILD_ID=...

# ============================================================================
# CSF MEMORY — read-path integrity verification (#1663 / #1703)
# ============================================================================
# Every MemoryRecord read from data/csf_memory carries a checksum. This controls
# what readMemoryRecords() does when a record's checksum doesn't match:
#   off     - no verification, zero cost, legacy behavior
#   warn    - recompute + log mismatches, KEEP the record anyway (default)
#   enforce - additionally DROP mismatching records before they reach a prompt
# JS and Python writers use different canonical-JSON schemes, so a record stamped
# by one runtime never verifies under the other — "warn" is the safe default until
# every writer in a given store shares one runtime's stamp (run
# scripts/restamp-csf-memory.js --apply to re-stamp a store under the JS scheme
# first). Only set "enforce" on a store you've confirmed is fully re-stamped
# (check: 0 "failed checksum" warnings in server logs) — flipping it on a store
# with legacy/cross-runtime records will silently drop them from chat context.
# CSF_VERIFY_ON_READ=warn

# ============================================================================
# ADVANCED FEATURES (Optional)
# ============================================================================

# LANTERN_IMAGE_LORA=models/csf-image/checkpoints/lantern-door-lora-final.safetensors
# LANTERN_CLOUD_MIRROR_URLS=...
# HFF_REPO_PATH=...

# ============================================================================
# TRADING / FINANCIAL SERVICES (Optional)
# ============================================================================

# Broker = IBKR Web API (hosted, https://api.ibkr.com/v1/api). Alpaca removed.
# Auth is an OAuth bearer token (the "API key") + the /tickle session cookie.
# See docs/IBKR-API-SETUP.md + ADR-0020.
# IBKR_API_KEY=your_oauth_bearer_token              # a.k.a. IBKR_OAUTH_TOKEN
# IBKR_ACCOUNT_ID=U1234567                          # DU… = paper; auto-discovered if omitted
# IBKR_BASE_URL=https://api.ibkr.com/v1/api         # default; set a local gateway URL to override
#
# Order placement is DRY by default and hard-gated (lib/trading-guard.js, ADR-0020):
# TRADER_LIVE=0                    # master arm switch — 1 to allow real orders
# MAX_ORDER_QTY=100                # per-order share cap
# MAX_ORDER_NOTIONAL=2000          # per-order $ cap (qty × price)
# TRADER_ALLOW_LIVE_ACCOUNT=0      # second opt-in required for a live (U*) account
#
# Alpaca (ADR-0027) — one-click OAuth app (register at app.alpaca.markets → Connect):
# ALPACA_OAUTH_CLIENT_ID=            # OAuth client id (inert until Alpaca activates the app)
# ALPACA_OAUTH_CLIENT_SECRET=        # OAuth client secret — never commit the real value
# Shared server paper keys (everyone paper-trades one real Alpaca paper account):
# ALPACA_API_KEY_ID=                 # paper API key id (dashboard → API keys)
# ALPACA_API_SECRET_KEY=             # paper API secret
# ALPACA_ENV=paper                   # 'live' only with real intent — see trading-guard gates
# Broker precedence when a user has BOTH IBKR (ADR-0022) and Alpaca connected:
# BROKER_PREFER=ibkr                 # 'alpaca' tries Alpaca first; the other stays the fallback
#
# Kalshi tight-band collector cadence (lib/kalshi-adaptive-poll.js). Default = fixed 6s.
# KALSHI_ADAPTIVE_POLL=1             # send-on-delta: poll delay = β/σ²ₘₐₓ from measured variance
# KALSHI_POLL_FLOOR_MS=6000          # never poll faster than this (today's cadence)
# KALSHI_POLL_CAP_MS=60000           # max staleness while the exchange is open with live markets
# KALSHI_POLL_IDLE_MS=60000          # cadence while the exchange is closed (was: 6s around the clock)
# KALSHI_POLL_SIGMA_REF=0.04         # variance rate (cents²/s) that maps to the floor cadence
#
# Sigma Trader (the long-horizon allocation book, ADR-0028) runs on its OWN Alpaca
# account so it never collides with the day-trader. Point it at a SEPARATE Alpaca
# paper account; with none set, the engine plans but refuses to place any order:
# SIGMA_ALPACA_API_KEY_ID=           # a SECOND paper account's key id
# SIGMA_ALPACA_API_SECRET_KEY=       # its secret
# SIGMA_ALPACA_ENV=paper             # keep it paper
# SIGMA_ARM=0                        # 1 = allow the engine to place (paper) rebalance orders
# SIGMA_SCHEDULE=0                   # 1 = run Sigma on its own schedule (rebalance on drift +
#                                    #     react to the brake). Needs SIGMA_ARM=1 to actually trade.
# SIGMA_SCHEDULE_MS=1200000          # how often to check (default 20 min); market-hours only
# SIGMA_MIN_REBALANCE_MS=3300000     # floor between actual rebalances (default ~55 min)

# === MCP Server ===
MCP_SERVER_PORT=8771
MCP_SERVER_HOST=127.0.0.1

